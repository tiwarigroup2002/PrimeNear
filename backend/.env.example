# ---- Server ----
PORT=3000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400
# Public base URL of this API (used for building file URLs)
PUBLIC_URL=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/primenear

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=1d
# 32+ char key used to encrypt bank account numbers at rest
DATA_ENCRYPTION_KEY=change_me_to_another_long_random_string

# ---- First super admin (used by `npm run seed`) ----
SUPERADMIN_EMAIL=admin@primenear.in
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_NAME=Super Admin

# ---- Admin panel URL (password reset links) ----
ADMIN_PANEL_URL=http://localhost:4200

# ---- Razorpay (optional; refunds are recorded as manual when not set) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email (optional; emails are logged to console when SMTP_HOST is empty) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PrimeNear <no-reply@primenear.in>"

# ---- OTP / SMS ----
# SMS gateway (not wired yet). While empty, OTPs are logged and returned as `devOtp` outside production.
SMS_PROVIDER=
# Optional fixed OTP for local testing (ignored when NODE_ENV=production)
DEV_FIXED_OTP=

# ---- Razorpay webhook (Dashboard → Webhooks → URL: https://<api>/api/payments/razorpay/webhook, event payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# India state / district / taluka / PIN directory (free India Post data). Downloaded once into storage/.
INDIA_LOCATIONS_URL=https://raw.githubusercontent.com/saravanakumargn/All-India-Pincode-Directory/master/all-india-pincode-html-csv.csv
# Optional: local CSV with the same columns (offline installs)
INDIA_LOCATIONS_FILE=
# Free India Post API for PIN codes missing from the directory
PINCODE_API_URL=https://api.postalpincode.in/pincode/
